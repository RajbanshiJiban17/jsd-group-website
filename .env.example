# ==========================================
# JSD GROUP — ENVIRONMENT CONFIGURATION
# ==========================================

# Database
DATABASE_URL=sqlite:///./jsd_group.db

# Authentication
JWT_SECRET=jsd-group-production-super-secret-key-2026-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Service (Jeesa AI Assistant)
# Providers supported: gemini, openai, local_rag
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_RATE_LIMIT_PER_MINUTE=30
AI_VERIFIED_ONLY_DEFAULT=true

# Email Notification (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ADMIN_EMAIL=jibanchy233@gmail.com

# Frontend Application
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_ANALYTICS_ID=
